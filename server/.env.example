# Copy to .env and fill in. Loaded by python-dotenv in wsgi.py.

# Shared secret the phone (and reviewer device) present as a bearer token.
# Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
SYNC_TOKEN=change-me-to-a-long-random-hex

# Optional Flask key (no sessions are used, but set it anyway).
SECRET_KEY=change-me-too

# SQLite replica file. WAL is enabled in app.py.
DATABASE_URL=sqlite:///ammas_codex.db

# Where media bytes (audio/image/video) are stored on the laptop's disk.
MEDIA_DIR=./media

# Max single upload (MB). Bump when video lands.
MAX_UPLOAD_MB=200

# Public origin reached through the Cloudflare Tunnel.
PUBLIC_ORIGIN=https://ammas-codex.abhijith-sriram.in

# CORS allowlist. "*" is safe here (bearer-token auth, not cookies). Or set your origin(s).
CORS_ORIGINS=*

# Dev server bind (prod uses waitress - see README).
HOST=127.0.0.1
PORT=5055
FLASK_DEBUG=1
